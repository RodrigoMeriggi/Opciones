# =============================================================================
# Seguridad: el sistema SIEMPRE inicia en paper trading.
# Ningún módulo puede habilitar trading real automáticamente.
# =============================================================================

# Modo de operación: paper | live
TRADING_MODE=paper

# Debe ser false salvo habilitación manual explícita
LIVE_TRADING_ENABLED=false

# true = bloquea nuevas compras; solo permite reducir/cerrar
EMERGENCY_STOP=true

# Confirmación manual requerida para live (dejar vacío en paper)
MANUAL_LIVE_CONFIRMATION=

# -----------------------------------------------------------------------------
# Límites de riesgo (también configurables en config/risk.yaml)
# -----------------------------------------------------------------------------
MAX_DAILY_LOSS=50000
MAX_POSITION_SIZE=0.35
MAX_OPEN_POSITIONS=5
MIN_DAYS_TO_EXPIRATION=5
FORCE_EXIT_DAYS_BEFORE_EXPIRATION=3

# -----------------------------------------------------------------------------
# Infraestructura
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://opciones:opciones@localhost:5432/opciones
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DASHBOARD_JWT_SECRET=dev-only-change-me

# Orígenes del dashboard (coma-separados). En prod: URL de Vercel.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Paper broker
# -----------------------------------------------------------------------------
PAPER_INITIAL_CASH=1000000
PAPER_COMMISSION_RATE=0.001
PAPER_SLIPPAGE_BPS=5
PAPER_LATENCY_MS=50

# -----------------------------------------------------------------------------
# Broker real — NO completar hasta tener documentación oficial del proveedor
# DOCUMENTACIÓN FALTANTE: credenciales y endpoints de ALyC autorizada.
# -----------------------------------------------------------------------------
# BROKER_API_URL=
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCOUNT_ID=
